/* STORM ENGINE - cartoon UI stylesheet.
   Rounded panels, chunky borders, thick silhouettes, bold numbers. */

:root {
    --navy: #1B2A4A;
    --navy-soft: #2C416B;
    --ink: #14203A;
    --sky: #3FA9EE;
    --cloud: #F4F9FF;
    --panel: #EAF4FF;
    --card: #FFFFFF;
    --muted: #5B6F8E;
    --yellow: #FFC83D;
    --yellow-dark: #D9941A;
    --orange: #FF8A3D;
    --green: #4CD07D;
    --green-dark: #2E9E58;
    --red: #FF5A4E;
    --purple: #9B6BFF;
    --cyan: #39D3E6;
}

.se-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    color: var(--navy);
    font-size: 16px;
}

.se-root.landscape { flex-direction: row; }
.se-root.portrait { flex-direction: column; }

.se-stage {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    position: relative;
}

.se-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------------------------------------------------------------- navigation */

.se-nav {
    background-color: var(--navy);
    flex-shrink: 0;
}

.landscape .se-nav {
    width: 98px;
    flex-direction: column;
    padding: 10px 6px;
    border-right-width: 4px;
    border-color: var(--ink);
}

.portrait .se-nav {
    height: 78px;
    flex-direction: row;
    padding: 6px 4px 8px 4px;
    border-top-width: 4px;
    border-color: var(--ink);
}

.se-nav-logo {
    align-items: center;
    margin-bottom: 8px;
}

.portrait .se-nav-logo { display: none; }

.se-tab {
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    margin: 3px;
    padding: 6px 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-direction: column;
}

.portrait .se-tab { flex-grow: 1; flex-basis: 0; }

.se-tab:hover { background-color: rgba(255, 255, 255, 0.08); }

.se-tab.selected {
    background-color: var(--navy-soft);
    border-width: 2px;
    border-color: #4E6CA3;
}

.se-tab-label {
    color: #BFD2F2;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 3px;
    -unity-text-align: middle-center;
    padding: 0;
}

.se-tab.selected .se-tab-label { color: #FFFFFF; }

.se-badge {
    position: absolute;
    top: 2px;
    right: 8px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--red);
    border-width: 2px;
    border-color: var(--navy);
}

/* ---------------------------------------------------------------- side / bottom panel */

.se-panelhost {
    background-color: var(--panel);
    border-color: var(--ink);
    flex-shrink: 0;
}

.landscape .se-panelhost {
    width: 480px;
    border-left-width: 4px;
}

.portrait .se-panelhost {
    height: 50%;
    border-top-width: 4px;
}

.se-panelhost.collapsed { display: none; }

.se-panel-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px 8px 16px;
    border-bottom-width: 3px;
    border-color: #C9DCF3;
    background-color: #DDEBFB;
}

.se-panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--navy);
    margin-left: 8px;
    flex-grow: 1;
}

.se-panel-scroll { flex-grow: 1; }

.se-panel-body { padding: 12px 12px 24px 12px; }

/* ---------------------------------------------------------------- generic text */

.se-h1 { font-size: 24px; -unity-font-style: bold; color: var(--navy); }
.se-h2 { font-size: 18px; -unity-font-style: bold; color: var(--navy); }
.se-h3 { font-size: 15px; -unity-font-style: bold; color: var(--navy); }
.se-body { font-size: 14px; color: #33466B; white-space: normal; }
.se-small { font-size: 12px; color: var(--muted); white-space: normal; }
.se-muted { color: var(--muted); }
.se-good { color: var(--green-dark); }
.se-bad { color: #D63A30; }
.se-center { -unity-text-align: middle-center; }
.se-right { -unity-text-align: middle-right; }

.se-section {
    font-size: 13px;
    -unity-font-style: bold;
    color: #6A7FA3;
    margin: 10px 4px 6px 4px;
    letter-spacing: 1px;
}

/* ---------------------------------------------------------------- cards */

.se-card {
    background-color: var(--card);
    border-radius: 16px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    padding: 10px 12px;
    margin-bottom: 10px;
}

.se-card.dim { background-color: #F1F5FB; border-color: #8FA3BF; }

.se-card-ribbon {
    position: absolute;
    top: -12px;
    left: 14px;
    background-color: #2E9E58;
    border-width: 2px;
    border-color: var(--navy);
}
.se-card.glow { border-color: var(--yellow-dark); background-color: #FFF8E3; }
.se-card.active { border-color: var(--green-dark); background-color: #EFFFF4; }

.se-row { flex-direction: row; align-items: center; }
.se-col { flex-direction: column; }
.se-grow { flex-grow: 1; flex-shrink: 1; }
.se-wrap { flex-wrap: wrap; }

.se-iconbox {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    border-width: 3px;
    border-color: var(--navy);
    align-items: center;
    justify-content: center;
    background-color: #E5F0FF;
    margin-right: 10px;
    flex-shrink: 0;
}

.se-tag {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 7px;
    border-radius: 8px;
    margin-right: 4px;
    color: #FFFFFF;
    background-color: var(--navy-soft);
}

.se-tag.add { background-color: #2E8BE0; }
.se-tag.mult { background-color: #E0602E; }
.se-tag.flat { background-color: #5B6F8E; }
.se-tag.conv { background-color: #9B6BFF; }
.se-tag.cond { background-color: #2E9E58; }

/* ---------------------------------------------------------------- buttons */

.se-btn {
    border-radius: 14px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    background-color: var(--yellow);
    color: var(--navy);
    -unity-font-style: bold;
    font-size: 15px;
    padding: 5px 12px;
    margin: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: translate, background-color;
    transition-duration: 0.06s, 0.12s;
}

.se-btn:hover { background-color: #FFD76E; border-color: var(--navy); }
.se-btn:focus { border-color: var(--navy); }
.se-btn:active { translate: 0 2px; border-bottom-width: 4px; background-color: #F5B92A; }

.se-btn.green { background-color: var(--green); }
.se-btn.green:hover { background-color: #6EDD96; }
.se-btn.blue { background-color: #5AB3FF; }
.se-btn.blue:hover { background-color: #7CC3FF; }
.se-btn.purple { background-color: #B08CFF; }
.se-btn.purple:hover { background-color: #C2A6FF; }
.se-btn.red { background-color: #FF7A6E; }
.se-btn.red:hover { background-color: #FF958B; }
.se-btn.white { background-color: #FFFFFF; }
.se-btn.white:hover { background-color: #F0F6FF; }
.se-btn.ghost { background-color: rgba(255, 255, 255, 0.2); border-color: rgba(255, 255, 255, 0.5); color: #FFFFFF; }

.se-btn.is-disabled,
.se-btn.is-disabled:hover,
.se-btn.is-disabled:active {
    background-color: #C9D3E2;
    color: #7C8BA5;
    border-color: #7C8BA5;
    translate: 0 0;
}

.se-btn.small { font-size: 13px; padding: 3px 8px; border-radius: 10px; border-bottom-width: 5px; }
.se-btn.big { font-size: 22px; padding: 10px 18px; border-radius: 18px; border-bottom-width: 8px; }

.se-iconbtn { flex-direction: row; align-items: center; justify-content: center; }
.se-iconbtn-label { margin-left: 6px; -unity-font-style: bold; padding: 0; }

.se-buybtn {
    min-width: 118px;
    flex-direction: column;
    align-items: center;
    padding: 3px 8px;
}

.se-buybtn-top { font-size: 12px; -unity-font-style: bold; padding: 0; margin: 0; }
.se-buybtn-cost { flex-direction: row; align-items: center; }
.se-buybtn-cost Label { font-size: 16px; -unity-font-style: bold; padding: 0; margin: 0 0 0 3px; }

.se-segment { flex-direction: row; background-color: #D3E3F7; border-radius: 12px; padding: 3px; }
.se-segment .se-btn { border-width: 0; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); font-size: 13px; padding: 4px 10px; margin: 0 1px; }
.se-segment .se-btn.selected { background-color: #FFFFFF; border-width: 2px; border-color: var(--navy); }

/* ---------------------------------------------------------------- bars */

.se-bar {
    background-color: #D5E2F2;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--navy);
    overflow: hidden;
    flex-grow: 1;
}

.se-bar-fill { height: 100%; width: 0; border-radius: 5px; }

/* ---------------------------------------------------------------- HUD */

.se-hud { padding: 0; }

.se-topbar {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    flex-direction: row;
    align-items: center;
}

.se-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 32, 58, 0.86);
    border-radius: 22px;
    padding: 3px 14px 3px 5px;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
    min-width: 96px;
}

.se-pill-value {
    color: #FFFFFF;
    font-size: 19px;
    -unity-font-style: bold;
    margin-left: 6px;
    padding: 0;
}

.se-pill-sub { color: #9FB6D6; font-size: 11px; margin-left: 4px; padding: 0; }

.portrait .se-pill { min-width: 0; padding-right: 10px; margin-right: 5px; }
.portrait .se-pill-value { font-size: 16px; }

.se-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 32, 58, 0.78);
    border-radius: 12px;
    padding: 3px 10px 3px 5px;
    margin-bottom: 5px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.16);
}

.se-chip-label { color: #CFE0FF; font-size: 13px; flex-grow: 1; padding: 0; margin-left: 5px; }
.se-chip-value { color: #FFFFFF; font-size: 15px; -unity-font-style: bold; padding: 0; margin-left: 8px; }
.se-chip.boosted { border-color: var(--yellow); background-color: rgba(120, 80, 10, 0.85); }
.se-chip.inactive { opacity: 0.5; }

.se-stats {
    position: absolute;
    right: 10px;
    top: 62px;
    width: 196px;
    align-items: flex-end;
}

.se-stats-list { align-self: stretch; margin-top: 6px; }

.portrait .se-stats {
    width: 118px;
    top: 58px;
}

.portrait .se-chip-label { font-size: 11px; }
.portrait .se-chip-value { font-size: 13px; }

.se-leftcol {
    position: absolute;
    top: 62px;
    left: 10px;
    align-items: flex-start;
}

.portrait .se-leftcol { top: 58px; }
/* On phones the live storm card takes the top of the stage. */
.portrait.storming .se-leftcol { display: none; }

.se-power {
    background-color: rgba(20, 32, 58, 0.82);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
    padding: 4px 12px 6px 12px;
    align-items: flex-start;
    margin-bottom: 6px;
}

.se-power:hover { border-color: rgba(255, 255, 255, 0.5); }

.se-power-title { color: #9FC4FF; font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; padding: 0; margin: 0; }

.se-power-value {
    color: var(--yellow);
    font-size: 24px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #3A2A00;
}

.portrait .se-power-value { font-size: 19px; }

.se-power-class {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    border-radius: 7px;
    padding: 1px 7px;
    margin: 2px 0 0 0;
}

.se-goal {
    width: 236px;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 12px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--navy);
    padding: 4px 9px 6px 9px;
    margin-top: 2px;
}

.portrait .se-goal { width: 186px; }

.se-goal-title { font-size: 10px; color: var(--orange); -unity-font-style: bold; padding: 0; margin: 0; letter-spacing: 1px; }
.se-goal-text { font-size: 12px; -unity-font-style: bold; white-space: normal; padding: 0; margin: 1px 0 4px 0; color: var(--navy); }
.se-goal-reward { font-size: 10px; color: var(--green-dark); -unity-font-style: bold; padding: 0; margin: 0 0 0 6px; flex-grow: 1; -unity-text-align: middle-right; }

.se-controls {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    flex-direction: row;
    align-items: flex-end;
}

.se-boostbar { flex-direction: row; align-items: flex-end; flex-grow: 1; }

.se-boost {
    width: 92px;
    height: auto;
    min-height: 88px;
    margin-right: 8px;
    align-items: center;
    justify-content: flex-start;
    border-radius: 18px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    background-color: #FFFFFF;
    padding: 4px 2px;
}

.portrait .se-boost { width: 64px; height: auto; min-height: 0; margin-right: 5px; }

.se-boost:hover { background-color: #F3F8FF; }
.se-boost:active { translate: 0 2px; }
.se-boost.active { background-color: #FFF1C2; border-color: var(--yellow-dark); }
.se-boost.locked { opacity: 0.55; }
.se-boost.locked .se-boost-time { font-size: 10px; color: #5B6F8E; }
.se-boost-name { font-size: 11px; -unity-font-style: bold; color: var(--navy); padding: 0; -unity-text-align: middle-center; }
.se-boost-time { font-size: 12px; -unity-font-style: bold; color: #2B5BA8; padding: 0; }
.portrait .se-boost-name { font-size: 9px; }

.se-stormbtn {
    width: 210px;
    height: 96px;
    border-radius: 22px;
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    background-color: #B7C4D8;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
}

.portrait .se-stormbtn { width: 150px; height: 82px; }

.se-stormbtn.ready { background-color: var(--yellow); }
.se-stormbtn.ready:hover { background-color: #FFD76E; }
.se-stormbtn:active { translate: 0 3px; border-bottom-width: 5px; }
.se-stormbtn.storming { background-color: #7A5CFF; }

.se-stormbtn-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    top: 0;
    width: 0;
    background-color: #FFE08A;
}

.se-stormbtn-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--navy);
    padding: 0;
    -unity-text-align: middle-center;
}

.portrait .se-stormbtn-title { font-size: 19px; }

.se-stormbtn-sub { font-size: 13px; -unity-font-style: bold; color: #33466B; padding: 0; -unity-text-align: middle-center; }
.se-stormbtn.storming .se-stormbtn-title,
.se-stormbtn.storming .se-stormbtn-sub { color: #FFFFFF; }

.se-stormhud {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    align-items: center;
}

.se-stormhud-card {
    background-color: rgba(28, 20, 70, 0.9);
    border-radius: 18px;
    border-width: 3px;
    border-color: #B8A6FF;
    padding: 6px 18px 8px 18px;
    align-items: center;
    min-width: 260px;
}

.se-stormhud-class { font-size: 24px; -unity-font-style: bold; color: #FFFFFF; padding: 0; letter-spacing: 2px; }
.se-stormhud-score { font-size: 30px; -unity-font-style: bold; color: var(--yellow); padding: 0; -unity-text-outline-width: 1px; -unity-text-outline-color: #3A2A00; }
.se-stormhud-line { font-size: 13px; color: #D7CCFF; padding: 0; }

.se-mega {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #E04BD8;
    border-radius: 10px;
    padding: 2px 10px;
    margin-top: 4px;
    border-width: 2px;
    border-color: #FFFFFF;
}

.se-roundbtn.weekly { background-color: rgba(214, 70, 60, 0.9); }
.se-roundbtn.weekly:hover { background-color: rgba(240, 90, 78, 0.95); }

.se-roundbtn {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(20, 32, 58, 0.86);
    align-items: center;
    justify-content: center;
    padding: 0;
    margin-left: 6px;
}

.se-roundbtn:hover { background-color: rgba(44, 65, 107, 0.95); }

/* ---------------------------------------------------------------- list rows */

.se-machine-level {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: var(--navy);
    border-radius: 8px;
    padding: 1px 7px;
    margin-left: 6px;
}

.se-milestone { font-size: 11px; color: #B8640E; -unity-font-style: bold; padding: 0; }

.se-slot {
    flex-grow: 1;
    flex-basis: 0;
    height: 86px;
    margin: 0 3px;
    border-radius: 14px;
    border-width: 3px;
    border-color: #8FA3BF;
    background-color: #F1F5FB;
    align-items: center;
    justify-content: center;
    padding: 4px;
}

.se-slot.filled { border-color: var(--navy); background-color: #FFFFFF; border-bottom-width: 5px; }
.se-slot.locked { border-color: #C9D3E2; background-color: #E3EAF4; }
.se-slot-name { font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; padding: 0; margin-top: 2px; }

.se-formula {
    background-color: var(--navy);
    border-radius: 16px;
    border-width: 3px;
    border-color: var(--ink);
    padding: 10px 12px;
    margin-bottom: 10px;
}

.se-formula-title { color: var(--yellow); font-size: 14px; -unity-font-style: bold; padding: 0; }
.se-formula-line { color: #DCE8FF; font-size: 13px; white-space: normal; padding: 0; margin-top: 4px; }
.se-formula-total { color: #FFFFFF; font-size: 24px; -unity-font-style: bold; padding: 0; margin-top: 4px; }

.se-term {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 2px 8px 2px 4px;
    margin: 3px 4px 0 0;
}

.se-term Label { color: #FFFFFF; font-size: 13px; -unity-font-style: bold; padding: 0; margin-left: 4px; }
.se-term .se-term-op { color: var(--yellow); margin-left: 0; }

.se-bdline { flex-direction: row; align-items: center; padding: 3px 0; border-bottom-width: 1px; border-color: #E4ECF7; }
.se-bdline Label { padding: 0; }

.se-lbrow {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #C9D8EC;
    padding: 6px 8px;
    margin-bottom: 6px;
}

.se-lbrow.me { background-color: #FFF4CF; border-color: var(--yellow-dark); }
.se-lbrow:hover { border-color: var(--navy-soft); }

.se-rank {
    width: 34px;
    height: 28px;
    border-radius: 9px;
    background-color: #DDE7F4;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    margin-right: 8px;
    padding: 0;
}

.se-rank.r1 { background-color: #FFD34D; }
.se-rank.r2 { background-color: #D6DEE9; }
.se-rank.r3 { background-color: #F2AE72; }

.se-toggle {
    flex-direction: row;
    align-items: center;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-color: #DCE6F3;
}

/* ---------------------------------------------------------------- popups */

.se-popups { justify-content: center; align-items: center; }

.se-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 16, 34, 0.62);
}

.se-popup {
    width: 520px;
    max-width: 94%;
    max-height: 92%;
    background-color: var(--cloud);
    border-radius: 24px;
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: var(--navy);
    padding: 0;
    overflow: hidden;
    scale: 0.9 0.9;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out-back, ease-out;
}

.se-popup.shown { scale: 1 1; opacity: 1; }

.se-popup-head {
    background-color: var(--navy);
    padding: 12px 16px;
    align-items: center;
    flex-shrink: 0;
}

.se-popup-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--yellow);
    padding: 0;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.se-popup-sub { font-size: 13px; color: #CFE0FF; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.se-popup-body { padding: 14px 16px; }
.se-popup-actions { flex-direction: row; justify-content: center; padding: 0 16px 16px 16px; flex-shrink: 0; }
.se-popup-actions .se-btn { margin: 0 6px; min-width: 130px; }

.se-bignum {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--navy);
    -unity-text-align: middle-center;
    padding: 0;
}

.se-kv { flex-direction: row; justify-content: space-between; padding: 4px 2px; border-bottom-width: 1px; border-color: #DCE6F3; }
.se-kv Label { padding: 0; font-size: 14px; }
.se-kv .v { -unity-font-style: bold; }

.se-textfield { margin: 6px 0; }
.se-textfield .unity-text-field__input {
    font-size: 18px;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--navy);
    background-color: #FFFFFF;
    color: var(--navy);
    padding: 6px 10px;
}

/* ---------------------------------------------------------------- toasts & fx */

.se-toasts {
    position: absolute;
    left: 0;
    right: 0;
    top: 58px;
    align-items: center;
}

.se-toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.97);
    border-radius: 16px;
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: var(--navy);
    padding: 6px 14px 6px 8px;
    margin-bottom: 6px;
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
}

.se-toast.shown { opacity: 1; translate: 0 0; }
.se-toast Label { padding: 0; margin-left: 8px; font-size: 14px; -unity-font-style: bold; color: var(--navy); white-space: normal; max-width: 380px; }

.se-popnum {
    position: absolute;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--yellow);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: #2A1D00;
    padding: 0;
    -unity-text-align: middle-center;
}

.se-popnum.big { font-size: 34px; color: #FFFFFF; -unity-text-outline-color: #5A1FA0; }
.se-popnum.mult { color: #FF8BF0; font-size: 26px; -unity-text-outline-color: #3A0A40; }

.se-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0);
}

/* ---------------------------------------------------------------- scroll view */

.se-root .unity-scroller--vertical { width: 10px; }
.se-root .unity-scroller--vertical .unity-slider { margin: 0; }
.se-root .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.se-root .unity-scroller--vertical .unity-base-slider__dragger { background-color: #9FB2CF; border-radius: 5px; border-width: 0; width: 8px; }
.se-root .unity-scroller--vertical .unity-repeat-button { display: none; }
.se-root .unity-scroller--horizontal { display: none; }


/* ---------------------------------------------------------------- engine level */

.se-levelpill {
    width: 50px;
    height: 50px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    flex-shrink: 0;
}
.se-levelring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.se-levelbadge {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: var(--yellow);
    border-width: 3px;
    border-color: var(--ink);
    align-items: center;
    justify-content: center;
}
.se-levelpill:hover .se-levelbadge { background-color: #FFD76E; }
.se-levelbadge-num { font-size: 16px; -unity-font-style: bold; color: var(--ink); padding: 0; margin: 0; -unity-text-align: middle-center; }
.portrait .se-levelpill { width: 44px; height: 44px; margin-right: 5px; }
.portrait .se-levelbadge { width: 31px; height: 31px; border-radius: 16px; }
.portrait .se-levelbadge-num { font-size: 14px; }

.se-unlock {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--navy);
    padding: 6px 8px;
    margin-bottom: 6px;
}
.se-unlock.locked { background-color: #F1F5FB; border-color: #8FA3BF; }
.se-unlock .se-h3 { white-space: normal; }
.se-unlock .se-small { white-space: normal; }
.se-unlock-kind { font-size: 10px; -unity-font-style: bold; color: var(--purple); padding: 0; margin: 0; letter-spacing: 1px; }
.se-iconbox.small { width: 42px; height: 42px; border-radius: 12px; margin-right: 8px; }

.se-road-level { flex-direction: row; align-items: center; margin: 10px 0 4px 0; }
.se-road-num {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: var(--navy);
    border-radius: 10px;
    padding: 2px 10px;
    margin: 0;
}
.se-road-next { font-size: 11px; -unity-font-style: bold; color: var(--green-dark); margin-left: 8px; padding: 0; }

.se-levelup-burst {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 520px;
    height: 520px;
    margin-left: -260px;
    margin-top: -260px;
}
.se-levelup .se-popup-head { background-color: #3A2A7A; overflow: hidden; }

/* ---------------------------------------------------------------- locked tabs */

.se-tab-lock { position: absolute; top: 4px; right: 6px; display: none; }
.se-tab.locked .se-tab-lock { display: flex; }
.se-tab.locked > .se-icon { opacity: 0.35; }
.se-tab.locked .se-tab-label { color: #7F93B5; }

/* ---------------------------------------------------------------- style studio */

.se-segment.wide { margin-bottom: 8px; justify-content: space-between; }
.se-segment.wide .se-btn { flex-grow: 1; padding: 5px 4px; }
.se-stylegrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.se-stylecard {
    width: 48%;
    align-items: center;
    padding: 8px 6px 10px 6px;
}
.se-stylecard.equipped { border-color: var(--green-dark); background-color: #EFFFF4; }
.se-stylecard.locked { background-color: #F1F5FB; border-color: #8FA3BF; }
.se-stylecard.locked .se-swatch { opacity: 0.45; }
.se-swatch { width: 84px; height: 72px; margin-bottom: 4px; }
.se-stylecard-name { font-size: 14px; -unity-font-style: bold; color: var(--navy); -unity-text-align: middle-center; white-space: normal; padding: 0; margin: 0; }
.se-stylecard-status { font-size: 11px; color: var(--muted); -unity-text-align: middle-center; padding: 0; margin: 2px 0 4px 0; }
.se-stylecard.equipped .se-stylecard-status { color: var(--green-dark); -unity-font-style: bold; }
.se-stylecard-btn { padding: 3px 14px; font-size: 13px; min-width: 90px; }

/* ---------------------------------------------------------------- machines extras */

.se-upgradecard { border-color: #1F6E8C; }
.se-card.focus { border-color: var(--yellow-dark); background-color: #FFF3C4; scale: 1.02 1.02; }
.se-card { transition-property: scale, background-color; transition-duration: 0.25s; }

.se-stepbtn { min-width: 36px; padding: 2px 8px; }
.se-stepvalue { width: 52px; -unity-text-align: middle-center; font-size: 14px; -unity-font-style: bold; color: var(--navy); padding: 0; }

.se-popnum.small { font-size: 16px; color: #FFFFFF; -unity-text-outline-color: #1B2A4A; }

/* ---------------------------------------------------------------- portrait compaction */

.portrait .se-tab { margin: 3px 1px; padding: 6px 0; }
.portrait .se-tab-label { font-size: 10px; }
.se-boost-dial { width: 48px; height: 48px; flex-shrink: 0; align-items: center; justify-content: center; }
.portrait .se-boost-dial { width: 42px; height: 42px; }
.portrait .se-boost-name { display: none; }
.portrait .se-stats { width: 104px; }
.portrait .se-stats-list { width: 104px; }
.portrait .se-chip { padding: 2px 8px 2px 4px; margin-bottom: 4px; }
.portrait .se-chip-label { display: none; }
.portrait .se-chip-value { flex-grow: 1; -unity-text-align: middle-right; }
.se-lbtitle { font-size: 11px; -unity-font-style: bold; color: var(--purple); padding: 0; margin: 0; }

.portrait.sheet-open .se-goal { display: none; }
.portrait.sheet-open .se-stats { display: none; }


/* ================================================================ minimal HUD (v3) */

.se-pill { min-width: 0; padding: 2px 12px 2px 4px; margin-right: 6px; }
.se-pill-value { font-size: 17px; }
.se-pill.small .se-pill-value { font-size: 14px; }
.se-pill.small { padding-right: 9px; }
.se-pill.gems { border-color: rgba(255, 79, 163, 0.7); padding-right: 4px; }
.se-pill.gems:hover { border-color: #FF8AC6; background-color: rgba(44, 65, 107, 0.95); }
.se-pill-plus {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--green);
    color: var(--ink);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 0 6px;
}
.se-surgetag {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--yellow);
    border-radius: 6px;
    padding: 0 5px;
    margin: 0 0 0 6px;
}
.portrait .se-pill { padding: 2px 8px 2px 3px; margin-right: 4px; }
.portrait .se-pill-value { font-size: 14px; margin-left: 4px; }
.portrait .se-pill.small .se-pill-value { font-size: 12px; }
.portrait .se-pill.gems { padding-right: 3px; }
.portrait .se-pill-plus { width: 17px; height: 17px; font-size: 14px; margin-left: 4px; }
.portrait .se-roundbtn { width: 34px; height: 34px; border-radius: 17px; margin-left: 4px; }
.se-topslot { flex-direction: row; align-items: center; flex-shrink: 0; }
.se-topbar > .se-pill, .se-topbar > .se-roundbtn, .se-topbar > .se-levelpill { flex-shrink: 0; }
.portrait .se-topslot.weekly,
.portrait .se-topslot.research { display: none; }
.portrait .se-topbar { left: 6px; right: 6px; top: 8px; }

.se-pediadot { display: none; top: -2px; right: -2px; }
.pedia-new .se-pediadot { display: flex; }

.se-statstoggle { margin-left: 0; }
.se-statstoggle.selected { background-color: rgba(58, 141, 255, 0.9); border-color: #FFFFFF; }
.portrait.sheet-open .se-stats { display: flex; }
.portrait.sheet-open .se-stats-list { display: none; }

.se-adoffer {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--navy);
    padding: 2px 10px 2px 3px;
    margin: 0 0 6px 0;
}
.se-adoffer:hover { background-color: #F3F8FF; }
.se-adoffer:active { translate: 0 1px; }
.se-adoffer-play {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--green);
    align-items: center;
    justify-content: center;
    margin-right: 4px;
}
.se-adoffer-text { font-size: 12px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0 0 0 4px; }
.se-adoffer.surge.active { background-color: #FFF1C2; border-color: var(--yellow-dark); }
.se-adoffer.surge.active.is-disabled .se-adoffer-play { display: none; }
.se-adoffer.is-disabled { opacity: 1; }

.se-stormcol { align-items: flex-end; }
.se-offers { align-items: flex-end; }

.se-stormhud-tag {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
    background-color: var(--yellow);
    border-radius: 7px;
    padding: 1px 8px;
    margin-bottom: 2px;
    letter-spacing: 1px;
}
.se-stormhud.tournament .se-stormhud-card { border-color: var(--yellow); background-color: rgba(70, 40, 6, 0.92); }

/* ---------------------------------------------------------------- modes */

.home .se-nav,
.home .se-panelhost,
.home .se-hud { display: none; }
.visiting .se-hud,
.editing .se-hud { display: none; }

.se-home {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding: 18px 16px 22px 16px;
}
.se-home-top { align-items: center; }
.se-home-logo {
    width: 330px;
    height: 170px;
    -unity-background-scale-mode: scale-to-fit;
}
.portrait .se-home-logo { width: 310px; height: 160px; }
.se-home-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 3px;
    padding: 0;
    margin: 2px 0 0 0;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #14203A;
    text-shadow: 0 4px 0 rgba(20, 32, 58, 0.6);
}
.se-home-sub {
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: rgba(20, 32, 58, 0.72);
    border-radius: 12px;
    padding: 3px 12px;
    margin-top: 6px;
}
.se-home-card {
    width: 460px;
    max-width: 100%;
    background-color: rgba(20, 32, 58, 0.78);
    border-radius: 26px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.25);
    padding: 14px;
}
.se-homebtn {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 10px 16px;
    margin-bottom: 10px;
    border-radius: 20px;
    border-bottom-width: 8px;
}
.se-homebtn-text { margin-left: 12px; flex-grow: 1; flex-shrink: 1; }
.se-homebtn-title { font-size: 28px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0; letter-spacing: 2px; -unity-text-align: middle-left; }
.se-homebtn-sub { font-size: 13px; color: #33466B; padding: 0; margin: 0; white-space: normal; -unity-text-align: middle-left; }
.se-homebtn.locked { background-color: #C9D3E2; }
.se-homebtn.locked .se-homebtn-title { color: #5B6F8E; }
.se-homebtn-lock { margin-left: 8px; }
.se-home-small { margin-top: 2px; }
.portrait .se-home-title { font-size: 34px; }
.portrait .se-homebtn-title { font-size: 24px; }

.se-visitbanner { position: absolute; left: 10px; right: 10px; top: 10px; align-items: center; }
.se-visitcard {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 32, 58, 0.9);
    border-radius: 18px;
    border-width: 3px;
    border-color: #5AB3FF;
    padding: 8px 10px 8px 12px;
    width: 560px;
    max-width: 100%;
}
.se-visit-name { font-size: 20px; -unity-font-style: bold; color: #FFFFFF; padding: 0; margin: 0; white-space: normal; }
.se-visit-info { font-size: 12px; color: #CFE0FF; padding: 0; margin: 0; white-space: normal; }

.se-editbar { position: absolute; left: 10px; right: 10px; bottom: 12px; align-items: center; }
.se-editcard {
    background-color: rgba(255, 255, 255, 0.96);
    border-radius: 18px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    padding: 8px 10px;
    width: 520px;
    max-width: 100%;
}
.se-edit-hint { font-size: 14px; -unity-font-style: bold; color: var(--navy); white-space: normal; padding: 0; margin: 0 0 6px 2px; }
.se-editcard .se-btn { margin-right: 6px; }

/* ---------------------------------------------------------------- shop */

.se-note { margin: 0 4px 8px 4px; }
.se-gembalance { padding: 8px 12px; }
.se-adrow { padding: 6px 0; border-bottom-width: 1px; border-color: #E4ECF7; }
.se-adrow .se-small { white-space: normal; }
.se-adrow.dim { opacity: 0.55; }
.se-card.dim { opacity: 0.6; }

.se-offer { background-color: #FFF4CF; border-color: var(--yellow-dark); }
.se-offer-tag {
    font-size: 10px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #E0602E;
    border-radius: 6px;
    padding: 1px 6px;
    margin: 0 0 2px 0;
    align-self: flex-start;
    letter-spacing: 1px;
}

.se-bundle { padding: 0 0 10px 0; overflow: hidden; }
.se-bundle > .se-small, .se-bundle > .se-row { margin-left: 10px; margin-right: 10px; }
.se-bundle-head { flex-direction: row; align-items: center; padding: 6px 10px; margin-bottom: 6px; }
.se-bundle-title { font-size: 17px; -unity-font-style: bold; color: #FFFFFF; flex-grow: 1; padding: 0; margin: 0; letter-spacing: 1px; -unity-text-outline-width: 1px; -unity-text-outline-color: #14203A; }
.se-bundle-tag { font-size: 10px; -unity-font-style: bold; color: var(--ink); background-color: #FFFFFF; border-radius: 6px; padding: 1px 6px; margin: 0; }
.se-bundle-items { justify-content: center; margin-bottom: 4px; flex-wrap: wrap; }
.se-bundle-count { font-size: 13px; -unity-font-style: bold; color: var(--navy); margin-left: 8px; padding: 0; min-width: 64px; -unity-text-align: middle-right; }
.se-bundle .se-btn { margin-right: 4px; }
.se-swatch.small { width: 54px; height: 48px; margin: 0 2px; }
.se-decorswatch.small { width: 48px; height: 48px; margin: 0 2px; }
.se-swatch.big { width: 150px; height: 128px; align-self: center; margin-bottom: 8px; }
.se-bundlecell { align-items: center; width: 96px; margin: 4px; }

.se-product { padding: 8px 10px; }
.se-pricebtn { min-width: 92px; }

.se-ribbon {
    position: absolute;
    top: 6px;
    right: -2px;
    font-size: 9px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: var(--navy-soft);
    border-radius: 6px 0 0 6px;
    padding: 1px 6px;
    margin: 0;
    letter-spacing: 1px;
}
.se-ribbon.gold { background-color: #D9941A; }
.se-ribbon.purple { background-color: #8E5CFF; }
.se-ribbon.red { background-color: #E0463A; }

.se-stylecard-bonus { font-size: 11px; -unity-font-style: bold; color: #2B5BA8; -unity-text-align: middle-center; white-space: normal; padding: 0; margin: 1px 0 0 0; }
.se-stylecard-bonus.se-good { color: var(--green-dark); }
.se-stylecard-status { min-height: 14px; }

/* ---------------------------------------------------------------- island */

.se-islandhead .se-note { margin: 8px 0 0 0; }
.se-limited { background-color: #FFF0F4; border-color: #E0463A; }
.se-decorwide { flex-direction: row; align-items: center; padding: 6px 4px 0 4px; }
.se-decorwide .se-stylecard-name,
.se-decorwide .se-stylecard-bonus,
.se-decorwide .se-stylecard-status { -unity-text-align: middle-left; }
.se-decorswatch { width: 76px; height: 70px; margin-bottom: 4px; flex-shrink: 0; }
.se-decorbtns { justify-content: center; margin-top: 2px; }
.se-decorbtns .se-btn { margin: 0 2px; min-width: 70px; }
.se-decorwide .se-decorbtns { justify-content: flex-start; }

/* ---------------------------------------------------------------- tournament */

.se-tourney { background-color: #FFF8E3; border-color: var(--yellow-dark); }
.se-tourney-kicker { font-size: 10px; -unity-font-style: bold; color: #B8640E; letter-spacing: 1px; padding: 0; margin: 0; }
.se-tourney-stats { margin: 8px 0; }
.se-tourney-stat {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #F0D9A8;
    padding: 4px 8px;
    margin: 0 3px;
    align-items: center;
}
.se-enterbtn { margin-top: 2px; }
.se-tag.good { background-color: #2E9E58; }
.se-tag.bad { background-color: #D6463A; }
.se-rule { padding: 4px 0; align-items: flex-start; }
.se-rewards { justify-content: space-between; }
.se-reward {
    width: 31%;
    align-items: center;
    background-color: #F4F8FF;
    border-radius: 10px;
    padding: 4px 2px;
    margin-bottom: 6px;
}
.se-reward-rank { font-size: 12px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0; }
.se-reward-gems { font-size: 15px; -unity-font-style: bold; color: #C2185B; padding: 0; margin: 0 0 0 3px; }

/* ---------------------------------------------------------------- stormpedia */

.se-pediacats { margin-bottom: 6px; }
.se-pediacats .se-btn { margin: 0 4px 4px 0; }
.se-pediacats .se-btn.selected { background-color: var(--yellow); }
.se-pediacats .se-btn.has-new { background-color: #FFE3E0; }
.se-pedia-q { font-size: 22px; -unity-font-style: bold; color: #8FA3BF; padding: 0; margin: 0; -unity-text-align: middle-center; }
.se-pediarow .se-small { white-space: normal; }
.se-newtag {
    font-size: 9px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #E0463A;
    border-radius: 5px;
    padding: 0 4px;
    margin: 0 0 0 6px;
}

/* ---------------------------------------------------------------- music picker */

.se-trackrow { padding: 6px 4px; border-bottom-width: 1px; border-color: #E4ECF7; border-radius: 10px; }
.se-trackrow.playing { background-color: #EFFFF4; }
.se-trackrow .se-small { white-space: normal; }
.se-trackrow .se-btn { margin-left: 6px; }
.se-tag.cozy { background-color: #E0602E; }
.se-tag.ambient { background-color: #5A6FD8; }

/* ---------------------------------------------------------------- daily rewards */

.se-stats-head { flex-direction: row; align-items: center; justify-content: flex-end; }
.se-dailybtn { margin-left: 0; margin-right: 6px; background-color: rgba(106, 44, 122, 0.92); }
.se-dailybtn:hover { background-color: rgba(136, 60, 154, 0.95); }
.se-dailybtn.waiting { border-color: var(--yellow); }
.se-dailydot { top: -3px; right: -3px; }
.portrait .se-dailybtn { margin-right: 4px; }

.se-homedaily {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: #FFE9F3;
    border-radius: 18px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: #8A2F5C;
    padding: 6px 12px;
    margin: 0 0 10px 0;
}
.se-homedaily:hover { background-color: #FFF4F9; }
.se-homedaily-title { font-size: 18px; -unity-font-style: bold; color: #6A1E48; padding: 0; margin: 0; letter-spacing: 1px; -unity-text-align: middle-left; }
.se-homedaily-sub { font-size: 12px; color: #7A3A5A; padding: 0; margin: 0; white-space: normal; -unity-text-align: middle-left; }
.se-homedaily .se-badge { top: -5px; right: -5px; width: 16px; height: 16px; border-radius: 8px; }

.se-daily-streak { margin-bottom: 6px; }
.se-daily-restore {
    background-color: #FFF1C2;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--yellow-dark);
    padding: 6px 8px;
    margin-bottom: 8px;
}
.se-daily-restore .se-btn { margin-left: 8px; }

.se-daycells { justify-content: space-between; margin-bottom: 8px; }
.se-daycell {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    background-color: #F4F0FF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #D8CCF2;
    padding: 4px 1px 5px 1px;
    margin: 0 2px;
    min-width: 0;
}
.se-daycell.big { flex-grow: 1.4; background-color: #FFF4CF; border-color: var(--yellow-dark); }
.se-daycell.current { border-color: #B65BD0; border-width: 3px; background-color: #FFFFFF; scale: 1.06 1.06; }
.se-daycell.collected { opacity: 0.55; }
.se-daycell-day { font-size: 10px; -unity-font-style: bold; color: #6A2C7A; padding: 0; margin: 0 0 2px 0; letter-spacing: 1px; }
.se-daycell-amount { font-size: 13px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 2px 0 0 0; }
.se-daycell-extra { font-size: 10px; color: var(--muted); padding: 0; margin: 0; }
.se-daycell-check { position: absolute; top: 18px; right: 2px; }
.se-daily-claim { font-size: 18px; padding: 8px 12px; margin: 2px 0 4px 0; }

.se-missionrow { padding: 6px 2px; border-bottom-width: 1px; border-color: #ECE4F7; }
.se-missionrow.claimed { opacity: 0.6; }
.se-mission-text { font-size: 13px; -unity-font-style: bold; color: var(--navy); white-space: normal; padding: 0; margin: 0 0 3px 0; }
.se-mission-count { font-size: 11px; -unity-font-style: bold; color: #6A2C7A; padding: 0; margin: 0 0 0 6px; min-width: 44px; -unity-text-align: middle-right; }
.se-mission-rewards { align-items: flex-end; margin-left: 6px; }
.se-missionrow .se-btn { margin-left: 6px; }
.se-mission-done { margin-left: 8px; }
.se-rewardchip { flex-direction: row; align-items: center; background-color: #F4F0FF; border-radius: 8px; padding: 1px 6px 1px 3px; margin-bottom: 2px; }
.se-rewardchip-text { font-size: 11px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0 0 0 3px; }

.se-daily-bonus {
    margin-top: 8px;
    background-color: #FBF3FF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #D8CCF2;
    padding: 6px 8px;
}
.se-daily-bonus .se-btn { margin-left: 6px; }

/* ---------------------------------------------------------------- languages */

.lang-complex, .lang-complex .unity-text-element { -unity-text-generator: advanced; letter-spacing: 0; }
.se-lang-native { -unity-text-generator: advanced; font-size: 17px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0; }
.se-lang-english { font-size: 11px; color: var(--muted); padding: 0; margin: 0; }
.se-langgrid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.se-langbtn { width: 48%; flex-direction: column; align-items: flex-start; padding: 6px 10px; margin-bottom: 6px; }
.se-langvalue { -unity-text-generator: advanced; }

/* ---------------------------------------------------------------- tutorial coach */

.se-coach { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.se-coach-dim { position: absolute; background-color: rgba(10, 16, 32, 0.6); }
.se-coach-ring {
    position: absolute;
    border-width: 3px;
    border-color: var(--yellow);
    border-radius: 14px;
    transition-property: scale;
    transition-duration: 0.7s;
    transition-timing-function: ease-in-out;
}
.se-coach-ring.pulse { scale: 1.06 1.06; }
.se-coach-bubble {
    position: absolute;
    width: 360px;
    background-color: #FFFFFF;
    border-radius: 18px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--navy);
    padding: 10px 12px;
}
.se-coach-face { margin-right: 8px; }
.se-coach-counter { font-size: 10px; -unity-font-style: bold; color: #6A2C7A; letter-spacing: 1px; padding: 0; margin: 0; }
.se-coach-title { font-size: 17px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0; white-space: normal; }
.se-coach-text { font-size: 14px; color: #33466B; white-space: normal; padding: 0; margin: 6px 0 0 0; }
.se-coach-hint { font-size: 12px; -unity-font-style: bold; color: var(--green-dark); white-space: normal; padding: 0; margin: 6px 0 0 0; }
.se-coach-actions { margin-top: 8px; }
.se-coach-actions .se-btn.ghost { color: var(--muted); border-color: #D5DEEA; }

/* Longer languages: the goal card's reward line wraps instead of running past the card. */
.se-goal-title { flex-shrink: 0; }
.se-goal-reward { flex-shrink: 1; white-space: normal; }

/* ================================================================ phone sizing (v4)
   Bigger, bolder HUD on phones: larger currencies, icons and buttons, and one menu button
   whose dropdown holds the less frequent actions. */

.se-menucatcher { background-color: rgba(0, 0, 0, 0); }

.se-hudmenu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 8px;
    background-color: rgba(20, 32, 58, 0.95);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.28);
    padding: 6px;
    min-width: 214px;
}
.se-hudmenu-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    padding: 5px 14px 5px 5px;
    margin: 1px 0;
}
.se-hudmenu-item:hover { background-color: rgba(255, 255, 255, 0.1); }
.se-hudmenu-item:active { background-color: rgba(255, 255, 255, 0.18); }
.se-hudmenu-item.selected { background-color: rgba(58, 141, 255, 0.38); }
.se-hudmenu-icon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.1);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}
.se-hudmenu-label { color: #FFFFFF; font-size: 16px; -unity-font-style: bold; padding: 0; margin: 0; white-space: nowrap; -unity-text-align: middle-left; }
.se-hudmenu-item .se-pediadot { top: 3px; right: auto; left: 34px; }
.se-menubtn.selected { background-color: rgba(58, 141, 255, 0.92); border-color: #FFFFFF; }

.se-boost-timerow { flex-direction: row; align-items: center; justify-content: center; }
.se-boost-lock { margin-right: 2px; }

.portrait .se-topbar { left: 8px; right: 8px; top: 8px; }
.portrait .se-levelpill { width: 54px; height: 54px; margin-right: 6px; }
.portrait .se-levelbadge { width: 38px; height: 38px; border-radius: 19px; }
.portrait .se-levelbadge-num { font-size: 17px; }
.portrait .se-pill { padding: 3px 10px 3px 4px; margin-right: 5px; border-radius: 22px; }
.portrait .se-pill-value { font-size: 19px; margin-left: 4px; }
.portrait .se-pill.small .se-pill-value { font-size: 17px; }
.portrait .se-pill.gems { padding-right: 4px; margin-right: 0; }
.portrait .se-pill-plus { width: 21px; height: 21px; border-radius: 11px; font-size: 17px; margin-left: 5px; }
.portrait .se-surgetag { font-size: 12px; margin-left: 5px; }
.portrait .se-topbar.tight .se-pill { padding-right: 7px; margin-right: 4px; }
.portrait .se-topbar.tight .se-pill.gems { padding-right: 4px; margin-right: 0; }
.portrait .se-topbar.tight .se-pill-value { font-size: 16px; }
.portrait .se-topbar.tight .se-pill.small .se-pill-value { font-size: 14px; }
.portrait .se-roundbtn { width: 44px; height: 44px; border-radius: 22px; margin-left: 6px; }

.portrait .se-leftcol { top: 70px; }
.portrait .se-stats { top: 70px; width: 118px; }
.portrait .se-stats-list { width: 118px; }
.portrait .se-chip-value { font-size: 15px; }
.portrait .se-power-title { font-size: 11px; }
.portrait .se-power-value { font-size: 23px; }
.portrait .se-power-class { font-size: 12px; }
.portrait .se-adoffer-text { font-size: 14px; }
.portrait .se-adoffer-play { width: 24px; height: 24px; border-radius: 12px; }
.portrait .se-goal { width: 214px; }
.portrait .se-goal-title { font-size: 11px; }
.portrait .se-goal-text { font-size: 14px; }
.portrait .se-goal-reward { font-size: 11px; }
.portrait .se-toast Label { font-size: 15px; max-width: 360px; }

.portrait .se-boost { width: 64px; margin-right: 5px; padding: 5px 1px 4px 1px; border-radius: 16px; }
.portrait .se-boost-dial { width: 46px; height: 46px; }
.portrait .se-boost-time { font-size: 13px; }
.portrait .se-boost.locked .se-boost-time { font-size: 12px; }
.portrait .se-stormbtn { width: 138px; height: 88px; }
.portrait .se-stormbtn-title { font-size: 21px; }
.portrait .se-stormbtn-sub { font-size: 13px; }

.portrait .se-nav { height: 84px; }
.portrait .se-tab { padding: 5px 0; }
.portrait .se-tab-label { font-size: 12px; }

.se-fps {
    position: absolute;
    left: 6px;
    bottom: 96px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    padding: 2px 6px;
    margin: 0;
}

/* Right column (gift, Energy Surge offer, stats) sizes to its content; the boost row keeps exact gaps. */
.se-stats > .se-adoffer { margin: 6px 0 0 0; }
.portrait .se-stats { width: auto; }
.portrait .se-stats-list { width: 118px; }
.portrait .se-controls { left: 8px; right: 8px; bottom: 8px; }
.portrait .se-boost { margin: 0 5px 0 0; }

/* Long numbers: the gem "+" folds away (the whole pill still opens the Gem shop). */
.portrait .se-topbar.tight .se-pill-plus { display: none; }
.portrait .se-topbar.tight .se-pill.gems { padding-right: 8px; }
.portrait .se-topbar.tight .se-levelpill { width: 50px; height: 50px; margin-right: 5px; }

/* Storm button title: one line; long words are scaled to fit by StormButton. */
.se-stormbtn-title { white-space: nowrap; }

/* ---------------------------------------------------------------- goal card (v5)
   Narrower on phones so the engine in the middle of the island stays visible; tap to fold it. */
.portrait .se-goal { width: 176px; }
.portrait .se-goal-text { font-size: 13px; }
.se-goal { transition-property: scale; transition-duration: 0.08s; }
.se-goal:active { scale: 0.97 0.97; }
.se-goal.folded { width: 108px; padding-bottom: 5px; }
.portrait .se-goal.folded { width: 108px; }
.se-goal.folded .se-goal-text,
.se-goal.folded .se-goal-reward { display: none; }
.se-goal.folded .se-goal-title { margin-bottom: 3px; }

/* ---------------------------------------------------------------- home shortcuts (v5)
   Three equal tiles, icon above the label, so they always fit the card (long languages wrap). */
.se-home-small > .se-btn {
    flex-direction: column;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 6px 4px 5px 4px;
}
.se-home-small > .se-btn .se-iconbtn-label {
    margin: 3px 0 0 0;
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Developer FPS readout (development builds only): top center, clear of cards and buttons. */
.se-fps { left: 50%; bottom: auto; top: 2px; translate: -50% 0; font-size: 11px; }

/* Balance chip on the right of a panel header (Research in the Lab), visible while the list scrolls. */
.se-panel-balance {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    background-color: #FFFFFF;
    border-radius: 14px;
    border-width: 2px;
    border-color: #B9CFEA;
    padding: 2px 11px 2px 5px;
    margin-left: 8px;
}
.se-panel-balance-value { font-size: 18px; -unity-font-style: bold; color: var(--navy); padding: 0; margin: 0 0 0 4px; }

/* ---------------------------------------------------------------- long-language fixes (v5)
   A name with a badge (machines, research, music) wraps instead of running under the button next to it. */
.se-row > .se-grow { min-width: 0; }
.se-row > .se-grow > .se-row { flex-wrap: wrap; }
/* Daily Rewards streak line wraps (German, Turkish...). */
.se-daily-streak .se-h3 { white-space: normal; flex-shrink: 1; }
/* Top-right dropdown: now above the panel sheet; long weekly names wrap inside a sensible width. */
.se-hudmenu { max-width: 330px; }
.se-hudmenu-label { white-space: normal; flex-shrink: 1; }

/* ---------------------------------------------------------------- launch intro
   The intro plays in the world; this layer only fades in from navy and carries the studio credit. */
.se-intro {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--navy);
    align-items: center;
    justify-content: center;
}
.se-intro-center { align-items: center; }
.se-intro-credit {
    position: absolute;
    bottom: 64px;
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
    letter-spacing: 3px;
    padding: 0;
    text-shadow: 0 2px 6px rgba(9, 16, 36, 0.9);
}
